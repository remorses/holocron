{
  "name": "@holocron.so/vite",
  "version": "0.38.0",
  "description": "Vite plugin for building documentation websites from MDX files with mintlify-compatible config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/holocron",
    "directory": "vite"
  },
  "license": "MIT",
  "homepage": "https://holocron.so",
  "bugs": "https://github.com/remorses/holocron/issues",
  "keywords": [
    "docs",
    "documentation",
    "mdx",
    "vite",
    "vite-plugin",
    "mintlify",
    "react-server-components"
  ],
  "bin": {
    "holocron": "dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "default": "./dist/vite-plugin.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./mdx": {
      "types": "./dist/mdx-exports.d.ts",
      "default": "./dist/mdx-exports.js"
    },
    "./data": {
      "types": "./dist/build-navigation-data.d.ts",
      "default": "./dist/build-navigation-data.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "default": "./dist/chat/index.js"
    },
    "./src/*": "./src/*",
    "./dist/*": "./dist/*"
  },
  "imports": {
    "#mermaid": {
      "types": "./dist/lib/mermaid-browser.d.ts",
      "ssr": "./dist/lib/empty-mermaid.js",
      "browser": "./dist/lib/mermaid-browser.js",
      "default": "./dist/lib/mermaid-browser.js"
    },
    "#memoize": {
      "types": "./dist/lib/memoize-node.d.ts",
      "workerd": "./dist/lib/memoize-workerd.js",
      "default": "./dist/lib/memoize-workerd.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate-schema": "tsx scripts/generate-schema.ts",
    "bundle-chat-css": "tsx scripts/bundle-chat-css.ts",
    "build": "pnpm generate-schema && pnpm bundle-chat-css && tsc && chmod +x dist/bin.js",
    "typecheck": "tsc",
    "test": "vitest --run",
    "prepublishOnly": "rm -rf dist *.tsbuildinfo && pnpm build"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.32.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@holocron.so/cli": "workspace:^",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/lucide": "^1.2.101",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@scalar/json-magic": "^0.12.8",
    "@scalar/openapi-upgrader": "^0.2.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dedent": "^1.7.2",
    "fflate": "^0.8.2",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "mdastic": "^0.5.1",
    "mermaid": "^11.12.0",
    "openapi-types": "^12.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-medium-image-zoom": "^5.4.3",
    "refractor": "^5.0.0",
    "safe-mdx": "^2.1.0",
    "spiceflow": "1.26.0-rsc.22",
    "string-dedent": "^3.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "yaml": "^2.8.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai": "^6.0.149",
    "postcss": "^8.5.16",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.4"
  }
}
